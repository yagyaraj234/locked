<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yagyaraj.locked.keepalive</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/Locked</string>
    <key>RunAtLoad</key>
    <true/>
    <!-- Relaunched after a kill or crash, but not after a normal Quit. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
</dict>
</plist>
